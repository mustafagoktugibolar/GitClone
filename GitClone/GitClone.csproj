<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Global Tool Settings -->
    <PackAsTool>true</PackAsTool>
    <PackageId>ilos</PackageId>
    <ToolCommandName>ilos</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <Version>1.1.96</Version>
    <Authors>goktugibolar</Authors>
    <Description>Lightweight Git-like CLI tool written in .NET</Description>
    <!-- Optional -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <UserSecretsId>7141097a-4c8b-49cf-9975-c9a05b5e986d</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10" />
  </ItemGroup>
</Project>